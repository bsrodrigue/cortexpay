# ──────────────────────────────────────────────────────────────────────────────
# CortexPay — Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# All variables are validated at startup — a misconfigured value will
# raise a clear error before the server accepts any traffic.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
# Allowed: development | staging | production
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cortex:cortex_secret_password@localhost:5432/cortex_pay

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── FX Engine ─────────────────────────────────────────────────────────────────
FX_QUOTE_TTL_SECONDS=90
DEFAULT_FX_RATE_USD_XOF=610.00
MIN_SPREAD_PCT=0.035
MAX_SPREAD_PCT=0.045

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# REQUIRED in production: ≥ 32 chars, cryptographically random
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=cortex_jwt_super_secret_signing_key_2026_fintech_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Webhooks ──────────────────────────────────────────────────────────────────
# REQUIRED in production: ≥ 16 chars, cryptographically random
# Generate with: openssl rand -hex 16
WEBHOOK_SECRET_KEY=cortex_webhook_secret_hmac_2026

# ── Admin Portal ──────────────────────────────────────────────────────────────
# REQUIRED in production: must be changed from the default
ADMIN_PASSWORD=cortexpay-admin

# ── Mock / Testing ────────────────────────────────────────────────────────────
OTP_MOCK_CODE=123456

# ── Orange Money (West Africa / WAEMU) ────────────────────────────────────────
# Set ORANGE_MONEY_ENABLED=true only when all four credentials below are set.
# Validation will fail at startup if any credential is missing when enabled.
#
# Sandbox base URL:    https://api.orange.com/orange-money-webpay/dev/v1
# Production Senegal:  https://api.orange.com/orange-money-webpay/sn/v1
# Production CI:       https://api.orange.com/orange-money-webpay/ci/v1
#
ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
